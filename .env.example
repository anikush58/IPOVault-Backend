NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://ipovault:ipovault@localhost:5432/ipovault
NSE_IPO_ENDPOINT=https://www.nseindia.com/api/ipo-current-issue
DISCOVERY_SCHEDULER_ENABLED=false
DISCOVERY_SCHEDULER_INTERVAL_MS=21600000
DISCOVERY_SCHEDULER_INITIAL_DELAY_MS=0

# Cryptographic Secrets
ALLOTMENT_ENCRYPTION_SECRET=your_secure_32_byte_or_longer_encryption_secret
ALLOTMENT_HASH_SECRET=your_secure_16_byte_or_longer_hash_secret

# Firebase Admin Authentication
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
