generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketSegment {
  MAINBOARD
  SME
}

enum ExchangeListing {
  NSE
  BSE
  BOTH
}

enum IpoStatus {
  DRAFT
  UPCOMING
  OPEN
  CLOSED
  ALLOTMENT_PENDING
  ALLOTMENT_COMPLETED
  LISTING_PENDING
  LISTED
  WITHDRAWN
  CANCELLED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DocumentType {
  DRHP
  RHP
  PROSPECTUS
  OTHER
}

enum DocumentParsingStatus {
  PENDING
  PARSED
  FAILED
}

enum LifecycleEventType {
  DRHP
  RHP
  ANCHOR
  OPEN
  CLOSE
  BASIS_OF_ALLOTMENT
  REFUND_INITIATION
  DEMAT_CREDIT
  LISTING
}

enum SourceType {
  OFFICIAL_FILING
  EXCHANGE
  REGISTRAR
  COMPANY
  SECONDARY
  MARKET_SIGNAL
}

enum SourceHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  FAILING
  DISABLED
}

enum DiscoveryStatus {
  NEW
  PROCESSING
  MATCHED
  CREATED
  DUPLICATE
  REJECTED
  ERROR
}

enum ProvenanceEntityType {
  COMPANY
  IPO
}

enum IpoChangeType {
  PRICE_BAND_CHANGED
  LOT_SIZE_CHANGED
  OPEN_DATE_CHANGED
  CLOSE_DATE_CHANGED
  LISTING_DATE_CHANGED
  STATUS_CHANGED
  ISSUE_SIZE_CHANGED
  FIELD_CHANGED
}

model Company {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName   String   @map("legal_name")
  displayName String   @map("display_name")
  cin         String?  @unique
  website     String?
  industry    String?
  sector      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ipos Ipo[]

  @@map("companies")
}

model Ipo {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  marketSegment  MarketSegment     @map("market_segment")
  exchange       ExchangeListing
  status         IpoStatus         @default(DRAFT)
  publicationStatus PublicationStatus @default(DRAFT) @map("publication_status")
  symbol               String?
  issueSize            Decimal?          @map("issue_size") @db.Decimal(20, 2)
  freshIssueSize       Decimal?          @map("fresh_issue_size") @db.Decimal(20, 2)
  ofsSize              Decimal?          @map("ofs_size") @db.Decimal(20, 2)
  issueShareCount      Decimal?          @map("issue_share_count") @db.Decimal(20, 0)
  freshIssueShareCount Decimal?          @map("fresh_issue_share_count") @db.Decimal(20, 0)
  ofsShareCount        Decimal?          @map("ofs_share_count") @db.Decimal(20, 0)
  faceValue            Decimal?          @map("face_value") @db.Decimal(20, 2)
  priceBandLow   Decimal?          @map("price_band_low") @db.Decimal(20, 2)
  priceBandHigh  Decimal?          @map("price_band_high") @db.Decimal(20, 2)
  lotSize        Int?              @map("lot_size")
  minimumLots    Int?              @map("minimum_lots")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company          Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lifecycleEvents  IpoLifecycleEvent[]
  sourceIdentities IpoSourceIdentity[]
  changeEvents     IpoChangeEvent[]
  allotmentCheckLogs AllotmentCheckLog[]
  allotmentCheckJobs AllotmentCheckJob[]
  documents        IpoDocument[]
  allotmentConfig  IpoAllotmentConfig?

  @@index([companyId])
  @@index([status])
  @@index([publicationStatus])
  @@index([symbol])
  @@map("ipos")
}

model IpoDocument {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipoId         String?               @map("ipo_id") @db.Uuid
  documentType  DocumentType          @map("document_type")
  sourceUrl     String?               @map("source_url")
  filePath      String?               @map("file_path")
  fileName      String?               @map("file_name")
  mimeType      String?               @map("mime_type")
  fileSizeBytes Int?                  @map("file_size_bytes")
  source        String                @default("MANUAL_UPLOAD")
  parsingStatus DocumentParsingStatus @default(PENDING) @map("parsing_status")
  parserVersion String?               @map("parser_version")
  extractionData Json?                @map("extraction_data") @db.JsonB
  errorMessage  String?               @map("error_message")
  uploadedAt    DateTime              @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ipo           Ipo?                  @relation(fields: [ipoId], references: [id], onDelete: Cascade)

  @@index([ipoId])
  @@map("ipo_documents")
}

model IpoAllotmentConfig {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipoId                 String    @unique @map("ipo_id") @db.Uuid
  registrar             String
  registrarIpoCode      String?   @map("registrar_ipo_code")
  allotmentSourceUrl    String?   @map("allotment_source_url")
  expectedAllotmentDate DateTime? @map("expected_allotment_date") @db.Date
  enabled               Boolean   @default(true)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ipo                   Ipo       @relation(fields: [ipoId], references: [id], onDelete: Cascade)

  @@map("ipo_allotment_configs")
}

model IpoLifecycleEvent {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipoId           String              @map("ipo_id") @db.Uuid
  eventType       LifecycleEventType  @map("event_type")
  eventDate       DateTime            @map("event_date") @db.Date
  sourceId        String?             @map("source_id") @db.Uuid
  sourceReference String?             @map("source_reference")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ipo    Ipo     @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  source Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([ipoId, eventType])
  @@index([eventType, eventDate])
  @@map("ipo_lifecycle_events")
}

model Source {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                     String             @unique
  name                     String
  sourceType               SourceType         @map("source_type")
  baseUrl                  String?            @map("base_url")
  priority                 Int                @default(100)
  enabled                  Boolean            @default(true)
  parserType               String?            @map("parser_type")
  parserVersion            String?            @map("parser_version")
  rateLimitPolicy          Json?              @map("rate_limit_policy") @db.JsonB
  authenticationRequired   Boolean            @default(false) @map("authentication_required")
  healthStatus             SourceHealthStatus @default(UNKNOWN) @map("health_status")
  lastSuccessAt            DateTime?          @map("last_success_at") @db.Timestamptz(6)
  lastFailureAt            DateTime?          @map("last_failure_at") @db.Timestamptz(6)
  lastCheckedAt            DateTime?          @map("last_checked_at") @db.Timestamptz(6)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lifecycleEvents  IpoLifecycleEvent[]
  sourceIdentities IpoSourceIdentity[]
  discoveryRecords DiscoveryRecord[]
  fieldProvenance  FieldProvenance[]
  changeEvents     IpoChangeEvent[]
  allotmentCheckLogs AllotmentCheckLog[]

  @@index([enabled])
  @@index([sourceType])
  @@map("sources")
}

model IpoSourceIdentity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipoId      String   @map("ipo_id") @db.Uuid
  sourceId   String   @map("source_id") @db.Uuid
  externalId String?  @map("external_id")
  symbol     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ipo    Ipo    @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([ipoId, sourceId])
  @@map("ipo_source_identities")
}

model DiscoveryRecord {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId        String           @map("source_id") @db.Uuid
  externalId      String?          @map("external_id")
  sourceReference String?          @map("source_reference")
  companyName     String?          @map("company_name")
  rawPayload      Json             @map("raw_payload") @db.JsonB
  contentHash     String           @map("content_hash")
  discoveredAt    DateTime         @map("discovered_at") @db.Timestamptz(6)
  processedAt     DateTime?        @map("processed_at") @db.Timestamptz(6)
  status          DiscoveryStatus  @default(NEW)
  errorMessage    String?          @map("error_message")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([sourceId, externalId])
  @@index([contentHash])
  @@map("discovery_records")
}

model FieldProvenance {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType      ProvenanceEntityType  @map("entity_type")
  entityId        String                @map("entity_id") @db.Uuid
  fieldName       String                @map("field_name")
  value           String
  sourceId        String                @map("source_id") @db.Uuid
  sourceReference String?               @map("source_reference")
  retrievedAt     DateTime              @map("retrieved_at") @db.Timestamptz(6)
  confidence      Decimal               @default(1.000) @db.Decimal(4, 3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, fieldName])
  @@index([sourceId, retrievedAt])
  @@map("field_provenance")
}

model IpoChangeEvent {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipoId           String        @map("ipo_id") @db.Uuid
  fieldName       String        @map("field_name")
  oldValue        String?       @map("old_value")
  newValue        String?       @map("new_value")
  sourceId        String?       @map("source_id") @db.Uuid
  sourceReference String?       @map("source_reference")
  detectedAt      DateTime      @map("detected_at") @db.Timestamptz(6)
  changeType      IpoChangeType @map("change_type")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  ipo    Ipo     @relation(fields: [ipoId], references: [id], onDelete: Restrict)
  source Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([ipoId, detectedAt])
  @@map("ipo_change_events")
}

enum AllotmentIdentifierType {
  PAN
  APPLICATION_NUMBER
  DP_CLIENT_ID
}

enum AllotmentResultStatus {
  ALLOTTED
  PARTIALLY_ALLOTTED
  NOT_ALLOTTED
  NOT_YET_AVAILABLE
  APPLICATION_NOT_FOUND
  INVALID_IDENTIFIER
  IPO_NOT_FOUND
  REGISTRAR_UNRESOLVED
  REGISTRAR_UNSUPPORTED
  UNSUPPORTED_IDENTIFIER
  SOURCE_UNAVAILABLE
  SOURCE_RESPONSE_INVALID
  CAPTCHA_REQUIRED
  RATE_LIMITED
  CONFLICTING_RESULTS
  TEMPORARY_ERROR
  UNKNOWN
}

model AllotmentCheckLog {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipoId          String                  @map("ipo_id") @db.Uuid
  sourceId       String?                 @map("source_id") @db.Uuid
  identifierType AllotmentIdentifierType @map("identifier_type")
  identifierHash String                  @map("identifier_hash")
  maskedId       String                  @map("masked_id")
  status         AllotmentResultStatus
  sharesApplied  Int?                    @map("shares_applied")
  sharesAllotted Int?                    @map("shares_allotted")
  latencyMs      Int?                    @map("latency_ms")
  errorMessage   String?                 @map("error_message")
  checkedAt      DateTime                @default(now()) @map("checked_at") @db.Timestamptz(6)

  ipo    Ipo     @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  source Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([ipoId, identifierHash])
  @@index([checkedAt])
  @@map("allotment_check_logs")
}

enum AllotmentJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

model AllotmentCheckJob {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?            @map("user_id")
  ipoId            String             @map("ipo_id") @db.Uuid
  status           AllotmentJobStatus @default(QUEUED)
  totalChecks      Int                @default(0) @map("total_checks")
  processedChecks  Int                @default(0) @map("processed_checks")
  successfulChecks Int                @default(0) @map("successful_checks")
  failedChecks     Int                @default(0) @map("failed_checks")
  errorMessage     String?            @map("error_message")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  ipo   Ipo                     @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  items AllotmentCheckJobItem[]

  @@index([userId])
  @@index([ipoId])
  @@index([status])
  @@map("allotment_check_jobs")
}

model AllotmentCheckJobItem {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId          String                  @map("job_id") @db.Uuid
  identifierType AllotmentIdentifierType @map("identifier_type")
  identifierHash String                  @map("identifier_hash")
  maskedId       String                  @map("masked_id")
  status         AllotmentResultStatus   @default(UNKNOWN)
  sharesApplied  Int?                    @map("shares_applied")
  sharesAllotted Int?                    @map("shares_allotted")
  latencyMs      Int?                    @map("latency_ms")
  errorMessage   String?                 @map("error_message")
  checkedAt      DateTime?               @map("checked_at") @db.Timestamptz(6)

  job AllotmentCheckJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([identifierHash])
  @@map("allotment_check_job_items")
}

model UserSavedPan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id")
  panEncrypted String   @map("pan_encrypted")
  panMasked    String   @map("pan_masked")
  panHash      String   @map("pan_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([panHash])
  @@map("user_saved_pans")
}

enum NotificationType {
  IPO_OPENED
  IPO_CLOSED
  IPO_LISTING_SOON
  IPO_DATA_CHANGED
  IPO_DATA_QUALITY_WARNING
  ALLOTTED_RESULT_AVAILABLE
}

enum DeliveryChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model Notification {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @map("user_id")
  type              NotificationType
  title             String
  message           String
  relatedEntityType String?          @map("related_entity_type")
  relatedEntityId   String?          @map("related_entity_id")
  metadata          Json?            @db.JsonB
  deduplicationKey  String           @map("deduplication_key")
  readAt            DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveries        NotificationDelivery[]

  @@unique([userId, deduplicationKey])
  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId      String          @map("notification_id") @db.Uuid
  channel             DeliveryChannel
  status              DeliveryStatus  @default(PENDING)
  attemptCount        Int             @default(0) @map("attempt_count")
  lastAttemptAt       DateTime?       @map("last_attempt_at") @db.Timestamptz(6)
  processingStartedAt DateTime?       @map("processing_started_at") @db.Timestamptz(6)
  deliveredAt         DateTime?       @map("delivered_at") @db.Timestamptz(6)
  failureReason       String?         @map("failure_reason")
  providerMessageId   String?         @map("provider_message_id")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  notification        Notification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([notificationId])
  @@index([status])
  @@index([status, processingStartedAt])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String           @map("user_id")
  notificationType NotificationType @map("notification_type")
  enabled          Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, notificationType])
  @@index([userId])
  @@map("notification_preferences")
}
